{
  "name": "paint-pallet",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Windows desktop app for inspecting miniature STLs and building painting guides",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run build:worker && electron-forge package",
    "make": "npm run build:worker && electron-forge make",
    "build:worker": "powershell -ExecutionPolicy Bypass -File scripts/build-worker.ps1",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
